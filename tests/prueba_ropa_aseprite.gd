extends SceneTree
const Character = preload("res://scripts/character.gd")
func _initialize() -> void:
	for id in ["fello", "yeya", "chichi"]:
		var ch = Character.new()
		ch.setup(id)
		assert(ch.cfg.has("shirt_texture"))
		var png: Image = (load("res://arte/personajes/%s/ropa.png" % id) as Texture2D).get_image()
		png.convert(Image.FORMAT_RGBA8)
		var texture: Image = ch._shirt_tex().get_image()
		texture.convert(Image.FORMAT_RGBA8)
		assert(texture.get_size() == Vector2i(64, 64))
		assert(texture.get_data() == png.get_data(), "No se utiliza la ropa de Aseprite: " + id)
		var old_image: Image = (load("res://arte/personajes/%s/ropa_16.png" % id) as Texture2D).get_image()
		old_image.resize(64, 64, Image.INTERPOLATE_NEAREST)
		old_image.convert(Image.FORMAT_RGBA8)
		assert(texture.get_data() != old_image.get_data(), "Ropa sin detalle real: " + id)
		var baseline = Character.new()
		baseline.cfg = Character.PRESETS[id].duplicate(true)
		assert(texture.get_data() != baseline._shirt_tex().get_image().get_data(), "No cambió el diseño")
		baseline.free()
		ch.free()
	var custom = Character.new()
	var cfg: Dictionary = Character.PRESETS["nena"].duplicate(true)
	cfg.shirt = Color(0.95, 0.5, 0.15)
	cfg.pattern = "rayas"
	custom.setup_cfg(cfg)
	var expected = Character.new()
	expected.cfg = cfg.duplicate(true)
	assert(custom._shirt_tex().get_image().get_data() == expected._shirt_tex().get_image().get_data())
	assert(not Character.PRESETS["nena"].has("shirt_texture"))
	custom.free()
	expected.free()
	print("ROPA ASEPRITE: tres diseños cargados, distintos al anterior; personalización conservada SIN FALLOS")
	quit()

