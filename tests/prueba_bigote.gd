extends SceneTree
const Character = preload("res://scripts/character.gd")
func _initialize() -> void:
	var preview := Image.create(192, 64, false, Image.FORMAT_RGBA8)
	for id in ["fello", "tito", "colmadero"]:
		var fixed = Character.new()
		fixed.setup(id)
		var neutral: Image = fixed.tex_open.get_image()
		var talk: Image = fixed.tex_talk.get_image()
		var wide: Image = fixed.tex_talk_wide.get_image()
		assert(talk.get_pixel(18, 42) == neutral.get_pixel(18, 44))
		assert(wide.get_pixel(18, 40) == neutral.get_pixel(18, 44))
		assert(talk.get_pixel(18, 46) == neutral.get_pixel(0, 0))
		assert(wide.get_pixel(30, 45).r > 0.9, "El bigote tapa dientes: " + id)
		if id == "fello":
			preview.blit_rect(neutral, Rect2i(0, 0, 64, 64), Vector2i.ZERO)
			preview.blit_rect(talk, Rect2i(0, 0, 64, 64), Vector2i(64, 0))
			preview.blit_rect(wide, Rect2i(0, 0, 64, 64), Vector2i(128, 0))
		fixed.free()
		var custom = Character.new()
		var cfg: Dictionary = Character.PRESETS.get(id, Character.EXTRA_PRESETS.get(id, {})).duplicate(true)
		cfg.erase("face_sheet")
		custom.setup_cfg(cfg)
		var closed: Image = custom.tex_open.get_image()
		var small: Image = custom.tex_talk.get_image()
		var opened: Image = custom.tex_talk_wide.get_image()
		assert(small.get_pixel(4, 10) == closed.get_pixel(4, 11))
		assert(opened.get_pixel(4, 10) == closed.get_pixel(4, 11))
		assert(small.get_pixel(4, 11) != closed.get_pixel(4, 11))
		assert(opened.get_pixel(7, 11).r > 0.9)
		custom.free()
	preview.resize(768, 256, Image.INTERPOLATE_NEAREST)
	preview.save_png("res://capturas/bigote_habla.png")
	print("BIGOTE: Fello, Tito y colmadero; caras Aseprite y personalizadas siguen labio y dejan dientes visibles SIN FALLOS")
	quit()
